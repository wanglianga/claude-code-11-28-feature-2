# 本地开发环境变量示例（复制为 .env 后按需修改；容器内默认值已可直接运行）
DATABASE_URL=postgresql+psycopg://ccdev:ccdev@127.0.0.1:5432/ccdev
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EQUATION_TOLERANCE=1e-8
SINGULAR_THRESHOLD=1e-10
CONDITION_LIMIT=1e10
AUTO_SEED=0
